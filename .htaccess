# Hostinger Apache / LiteSpeed Configuration for Elephant House AR Game
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /ElephantHouseGame/

    # Prevent directory browsing
    Options -Indexes

    # Custom 404 Error Document
    ErrorDocument 404 /ElephantHouseGame/out/404.html

    # If already requesting /out, let it pass
    RewriteRule ^out/ - [L]

    # Serve index.html if root of subfolder is requested
    RewriteRule ^$ out/index.html [L]

    # Route static Next.js assets to out/
    RewriteRule ^_next/(.*)$ out/_next/$1 [L]
    RewriteRule ^models/(.*)$ out/models/$1 [L]
    RewriteRule ^wasm/(.*)$ out/wasm/$1 [L]
    RewriteRule ^eh-portal/?$ out/eh-portal/index.html [L]
    RewriteRule ^eh-portal/(.*)$ out/eh-portal/$1 [L]
    RewriteRule ^(logo\.png|icon\.png|favicon\.ico|favicon\.png|file\.svg|globe\.svg|window\.svg)$ out/$1 [L]

    # General fallback: if requested file exists inside out/, serve it
    RewriteCond %{DOCUMENT_ROOT}/ElephantHouseGame/out/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public_html/ElephantHouseGame/out/$1 -f
    RewriteRule ^(.*)$ out/$1 [L]

    # Fallback to out/index.html for any unhandled routes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ out/index.html [L]
</IfModule>

# MIME types for AR MediaPipe WASM and AI models
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/octet-stream .task
    AddType application/octet-stream .tflite
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>

# Security & CORS Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Access-Control-Allow-Origin "*"
</IfModule>

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/wasm image/svg+xml
</IfModule>
