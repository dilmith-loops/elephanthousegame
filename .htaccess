# Directory Index configuration for LiteSpeed & Apache
DirectoryIndex frontend/out/index.html index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Custom 404 Error Document (relative fallback)
    ErrorDocument 404 /arwonder/frontend/out/404.html

    # Block access to hidden files and sensitive directories (.git, .env, etc.)
    RewriteRule (^|/)(\.git|\.env|\.htaccess|\.env\..*) - [F,L]

    # Allow .well-known (e.g. security.txt, ACME challenges)
    RewriteRule ^\.well-known/ - [L]

    # 1. Forward all API requests directly to Laravel Backend
    RewriteCond %{REQUEST_URI} api/ [NC]
    RewriteRule ^(.*)$ index.php [L]

    # Forward uploaded media files to backend public storage
    RewriteRule ^uploads/(.*)$ backend/public/uploads/$1 [L]

    # 2. If requesting frontend/out/ directory directly, pass through
    RewriteRule ^frontend/out/ - [L]

    # 3. Route static Next.js assets to frontend/out/
    RewriteRule ^_next/(.*)$ frontend/out/_next/$1 [L]
    RewriteRule ^models/(.*)$ frontend/out/models/$1 [L]
    RewriteRule ^wasm/(.*)$ frontend/out/wasm/$1 [L]
    RewriteRule ^eh-portal/?$ frontend/out/eh-portal/index.html [L]
    RewriteRule ^eh-portal/(.*)$ frontend/out/eh-portal/$1 [L]
    RewriteRule ^terms/?$ frontend/out/terms/index.html [L]
    RewriteRule ^privacy/?$ frontend/out/privacy/index.html [L]
    RewriteRule ^(logo\.png|icon\.png|favicon\.ico|favicon\.png|og_image\.png|file\.svg|globe\.svg|window\.svg)$ frontend/out/$1 [L]

    # 4. Serve root to frontend/out/index.html
    RewriteRule ^$ frontend/out/index.html [L]

    # 5. General fallback: if file exists inside frontend/out/, serve it
    RewriteCond %{DOCUMENT_ROOT}/arwonder/frontend/out/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public_html/arwonder/frontend/out/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/frontend/out/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public_html/frontend/out/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/elephanthousegame/frontend/out/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public_html/elephanthousegame/frontend/out/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/ElephantHouseGame/frontend/out/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public_html/ElephantHouseGame/frontend/out/$1 -f
    RewriteRule ^(.*)$ frontend/out/$1 [L]

    # 6. Fallback to frontend/out/index.html for any unhandled routes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ frontend/out/index.html [L]
</IfModule>

# MIME types for AR MediaPipe WASM and AI models
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/octet-stream .task
    AddType application/octet-stream .tflite
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>

# Security & CORS Headers for Live Mobile/Web APIs
<IfModule mod_headers.c>
    # 1. Dynamic Origin-scoped CORS for all domains & subdomains
    SetEnvIfNoCase Origin "^https?://.*$" CORS_ALLOW_ORIGIN=$0
    Header set Access-Control-Allow-Origin "%{CORS_ALLOW_ORIGIN}e" env=CORS_ALLOW_ORIGIN
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, X-Admin-Token"
    Header set Access-Control-Max-Age "86400"
    Header set Vary "Origin"

    # 2. Strict Transport Security (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # 3. Defense-in-Depth Content Security Policy (CSP)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://storage.googleapis.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: data:; connect-src 'self' https: http: blob: data:; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"

    # 4. Anti-Clickjacking & Anti-MIME Sniffing
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"

    # 5. Referrer Policy & Permissions Policy (explicitly guarding AR camera access)
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"

    # 6. Strip backend and hosting stack disclosure headers
    Header unset X-Powered-By
    Header unset Server
    Header unset X-Turbo-Charged-By
    Header unset platform
    Header unset panel
    Header always unset X-Powered-By
    Header always unset Server
    Header always unset platform
    Header always unset panel
    Header always unset X-Turbo-Charged-By
</IfModule>

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/wasm image/svg+xml
</IfModule>
